# ==========================================
# GERAL: Sistema Operacional e Editores
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# PYTHON: Caches e Builds
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# AMBIENTES VIRTUAIS E DEPENDÊNCIAS
# ==========================================
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ==========================================
# TESTES E LOGS
# ==========================================
.pytest_cache/
.mypy_cache/
.tox/
.coverage
htmlcov/
*.log
logs/

# ==========================================
# DADOS DO PROJETO E ARQUIVOS GERADOS
# Ignoramos tudo dentro dessas pastas, mas mantemos o .gitkeep para preservar a estrutura
# ==========================================
data/*
!data/.gitkeep

pdfs/*
!pdfs/.gitkeep

reports/*
!reports/.gitkeep

images/*
!images/.gitkeep

output/*
!output/.gitkeep
# Ignore reports directory inside output
output/reports/
!output/reports/.gitkeep

downloads/*
!downloads/.gitkeep

# Bancos de dados locais SQLite
*.db
*.sqlite3

# Arquivos temporários e backups
*.tmp
*.temp
*.bak

# ==========================================
# EXCEÇÕES IMPORTANTES
# ==========================================
!.env.example
!frontend/index.html

# Additional outputs
relatorio/*
!relatorio/.gitkeep
src/data/
src/download/data/
src/download/test_dois.txt
src/search/output/
src/search/quary.txt
patch_modal.html

# Node.js dependencies
node_modules/
package-lock.json

src/download/Relat*.txt
